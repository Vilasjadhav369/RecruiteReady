# ==============================
# RecruitReady - Root .gitignore
# ==============================

# Dependencies
node_modules/

# Environment files
.env
.env.*
!.env.example

# Build output
dist/
build/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/

# Coverage
coverage/

# Temporary files
*.tmp
*.temp
