# ==============================================================================
# RecruiteReady - Frontend Environment Variables (.env.example)
# ==============================================================================

# Backend API Base URL
# - In local development: leave unset or set to '/api' to use Vite's dev proxy (http://localhost:5000).
# - In production: set to the public URL of your deployed backend API (including the /api prefix).
# Example: VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=/api

# Google Identity Services / OAuth 2.0 Web Client ID
# - Public client ID created in Google Cloud Console
# - Safe for browser exposure (never put secrets here)
# Example: VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
