{
  "name": "recruitready-backend",
  "version": "1.0.0",
  "description": "RecruitReady API Server - Placement Preparation Portal",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:content": "node src/scripts/seedDevContent.js",
    "test": "vitest run",
    "test:integration": "node src/scripts/testPhase10ObservabilitySuite.js",
    "test:all": "node src/scripts/testPhaseP0AssessmentSecuritySuite.js && node src/scripts/testLoginRegistrationSuite.js && node src/scripts/testPhase10ObservabilitySuite.js && node src/scripts/testAuthSuite.js && node src/scripts/testAdminProductivitySuite.js && node src/scripts/testCompanyPreparationSuite.js",
    "test:p0": "node src/scripts/testPhaseP0AssessmentSecuritySuite.js",
    "test:login-reg": "node src/scripts/testLoginRegistrationSuite.js",
    "test:auth": "node src/scripts/testAuthSuite.js",
    "test:admin": "node src/scripts/testAdminProductivitySuite.js",
    "test:company": "node src/scripts/testCompanyPreparationSuite.js",
    "test:quality": "node src/scripts/testPhase10ObservabilitySuite.js"
  },
  "keywords": [
    "recruitready",
    "placement",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
