# ==============================================================================
# RecruiteReady - Backend Environment Variables (.env.example)
# ==============================================================================

# Server Port (optional, defaults to 5000)
PORT=5000

# Environment Mode ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String (Required)
# - Local Development: mongodb://127.0.0.1:27017/recruiteready
# - Production (MongoDB Atlas / Hosted):
#   mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/recruiteready?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/recruiteready

# Authentication / JWT Configuration (Required)
# - In production, generate a cryptographically strong 64-character hex secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_development_jwt_secret
JWT_EXPIRES_IN=7d

# CORS Allowed Client Origin(s) (Required)
# - Local Development: http://localhost:5173
# - Production: Public frontend URL(s). Comma-separated if multiple domains (e.g. root + www).
#   Example: CLIENT_URL=https://recruiteready.com,https://www.recruiteready.com
CLIENT_URL=http://localhost:5173

# Optional: Remote Code Execution Sandbox URL (e.g. Judge0 or Piston API)
# - If omitted, code execution requests safely return service status without executing on the host.
# CODE_EXECUTION_URL=https://judge0-instance.yourdomain.com

# Initial Administrator Provisioning (Development / Initial Setup ONLY)
# - Used by `npm run seed:admin` to create the initial admin account.
# - DO NOT leave production admin passwords in persistent .env files.
ADMIN_EMAIL=admin@recruiteready.local
ADMIN_PASSWORD=your_secure_dev_password
